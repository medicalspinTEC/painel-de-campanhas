// Schema do painel de follow-up para WhatsApp.
// Após alterar este arquivo rode: pnpm prisma:generate && pnpm prisma:migrate

generator client {
  provider        = "prisma-client-js"
  output          = "../lib/generated/prisma"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  novo
  /// Lead que iniciou a conversa por conta própria (escreveu no WhatsApp antes de receber
  /// qualquer campanha). Só existe com o plugin CRM ativo: sem ele o status não aparece nem
  /// pode ser aplicado.
  contato_iniciado
  em_campanha
  /// Lead que já esteve em alguma campanha e foi removido manualmente dela
  /// (ação "Remover da campanha"), sem ter respondido. Diferente de `novo`
  /// (nunca esteve em campanha alguma) e de `encerrado` (saiu porque a
  /// campanha foi encerrada, não por remoção manual).
  sem_campanha
  respondeu
  encerrado
  /// Lead que não deve receber nenhum tipo de campanha (opt-out, pedido do
  /// próprio lead etc.). Não pode ser vinculado a campanhas (manual, em massa,
  /// importação, filtro automático, No Code ou chat), mas continua conversando
  /// normalmente no chat. Só deixa de valer quando alguém troca o status.
  nao_contatar
}

enum CampaignStatus {
  ativa
  pausada
  encerrada
  rascunho
}

/// Tipo de campanha, escolhido na criação e imutável depois:
///  - `padrao`: uma única sequência de mensagens (dia/horário) disparada
///    igualmente para todos os leads vinculados.
///  - `individual`: sem sequência; cada lead recebe UMA mensagem própria,
///    definida manualmente no vínculo (`LeadCampaign.mensagemIndividual`),
///    enviada uma única vez (sem recorrência).
enum CampaignTipo {
  padrao
  individual
}

enum EventType {
  mensagem_enviada
  falha
  resposta
  campanha_iniciada
  campanha_encerrada
  removido_campanha
}

/// Nível de acesso do usuário do painel (hierarquia: root > admin > padrao).
///  - `root`: acesso total; controla todos os níveis e define o que cada admin
///    pode acessar (`User.secoes`) e controlar (`User.poderes`).
///  - `admin`: acessa só as seções liberadas pelo root e só controla o que o
///    root permitiu; gerencia apenas usuários `padrao`.
///  - `padrao`: acessa apenas as seções liberadas por quem o gerencia (`User.secoes`).
enum UserRole {
  admin
  padrao
  root
}

enum ScheduledMessageStatus {
  pendente
  enviada
  falhou
}

/// Nível de severidade dos logs de sistema (não confundir com eventos de lead).
enum AppLogNivel {
  info
  aviso
  erro
  critico
}

model Lead {
  id       String @id @default(cuid())

  /// Instância (espaço de dados) dona deste registro. Ver `Workspace`.
  workspaceId String
  nome     String
  telefone String

  // Dimensões de segmentação. Ficam como texto para que novos produtos ou
  // marcas não exijam uma migration de enum.
  produto String
  marca   String
  persona String
  regiao  String

  status LeadStatus @default(novo)

  // Anotações livres da equipe sobre o lead. Opcionais e editáveis a qualquer
  // momento pela página de detalhe do lead.
  notas String?

  // Identificador do negócio (ex.: CRM externo) associado ao lead. Opcional,
  // texto livre digitado pelo usuário no cadastro.
  negocio String?

  // Identificador da atividade associado ao lead. Opcional.
  atividade String?

  campanhaId String?
  campanha   Campaign? @relation(fields: [campanhaId], references: [id], onDelete: SetNull)

  campanhas LeadCampaign[]

  entradaCampanhaEm DateTime?
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt

  eventos TimelineEvent[]
  mensagensAgendadas ScheduledMessage[]
  notasInternas ChatInternalNote[]
  /// Plugin CRM: departamento/atendente responsável pela conversa (1:1, opcional).
  atendimento LeadAtendimento?
  transferencias AtendimentoTransferencia[]
  /// Estado do bot nesta conversa (pausa quando um humano assume).
  botConversa BotConversa?
  followUpConversa FollowUpConversa?

  // A listagem ordena por data de criação e filtra por campanha e status.
  @@index([campanhaId])
  @@index([status])
  @@index([criadoEm])
  @@index([workspaceId])
}

model ChatInternalNote {
  id     String   @id @default(cuid())
  texto  String
  autor  String?
  data   DateTime @default(now())
  leadId String
  lead   Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, data])
}

model Campaign {
  id        String         @id @default(cuid())

  /// Instância (espaço de dados) dona deste registro. Ver `Workspace`.
  workspaceId String
  nome      String
  descricao String?
  status    CampaignStatus @default(rascunho)

  /// Define se a campanha usa uma sequência única para todos (`padrao`) ou
  /// uma mensagem individual por lead (`individual`). Escolhido na criação.
  tipo CampaignTipo @default(padrao)

  /// Identificador sequencial e imutável para importação por planilha. Gerado
  /// automaticamente a partir de 1 (o usuário não edita). Permite que o arquivo
  /// traga este número na coluna "campanha" em vez do nome exato da campanha.
  idImportacao Int @unique @default(autoincrement())

  recorrenciaDias Int       @default(7)
  dataFinal       DateTime?

  // Instância da Evolution que envia as mensagens desta campanha (igual ao
  // `nome` em Instance / instanceName na Evolution). Nulo = usa a instância
  // mais recente cadastrada no app, para campanhas sem escolha explícita.
  instanciaNome String?

  // Marca o momento do último (re)início da campanha. A dedupe de envio só
  // considera mensagens disparadas a partir daqui, então reiniciar a campanha
  // permite reenviar a mensagem inicial aos leads.
  reiniciadaEm DateTime?

  // Filtros de público da campanha (nulo = sem restrição na dimensão).
  filtroProduto String?
  filtroMarca   String?
  filtroPersona String?
  filtroRegiao  String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  mensagens    CampaignMessage[]
  leads        Lead[]
  leadCampaigns LeadCampaign[]
  eventos      TimelineEvent[]

  @@index([status])
  @@index([criadoEm])
  @@index([workspaceId])
}

model LeadCampaign {
  id String @id @default(cuid())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  campanhaId String
  campanha   Campaign @relation(fields: [campanhaId], references: [id], onDelete: Cascade)

  criadoEm DateTime @default(now())

  // Momento agendado para a próxima mensagem deste lead nesta campanha.
  // Definido ao pular manualmente uma mensagem: zera o contador e passa a
  // contar até o próximo disparo (ou até a recorrência, se não houver mais).
  proximaMensagemEm DateTime?

  // Marca um reinício de ciclo apenas para este lead (ex.: pular a partir da
  // última mensagem). Entra no cálculo de dedupe junto de Campaign.reiniciadaEm
  // para liberar o reenvio da sequência a este lead específico.
  cicloReiniciadoEm DateTime?

  // Usados apenas quando a campanha (`Campaign.tipo`) é `individual`: o texto
  // que este lead específico deve receber, e o momento em que foi enviado
  // (disparo único — null significa que ainda está pendente).
  mensagemIndividual  String?
  enviadaIndividualEm DateTime?

  @@unique([leadId, campanhaId])
  @@index([campanhaId])
  @@index([leadId])
}

model CampaignMessage {
  id      String @id @default(cuid())
  dia     Int
  horario String
  texto   String

  // Imagem/vídeo/arquivo opcional enviado junto com a mensagem. O conteúdo NÃO fica no banco:
  // vive numa pasta do servidor (ver `lib/campanha-anexo-storage.ts`) e aqui há só a referência.
  anexoId      String?
  anexoTipo    String?
  anexoMime    String?
  anexoNome    String?
  anexoTamanho Int?

  campanhaId String
  campanha   Campaign @relation(fields: [campanhaId], references: [id], onDelete: Cascade)

  eventos TimelineEvent[]

  // A sequência é sempre lida na ordem do dia de disparo.
  @@index([campanhaId, dia])
}

model ScheduledMessage {
  id                String                 @id @default(cuid())
  texto             String
  instanciaNome     String?
  agendadoPara      DateTime
  status            ScheduledMessageStatus @default(pendente)
  tentativas        Int                    @default(0)
  ultimaTentativaEm DateTime?
  erro              String?
  criadoEm          DateTime               @default(now())
  enviadoEm         DateTime?

  leadId String
  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([status, agendadoPara])
  @@index([leadId, agendadoPara])
}

/// Produtos cadastrados pela equipe na página de Segmentação.
/// O nome é a chave de negócio: os leads guardam o produto como texto (o nome),
/// então esta tabela é apenas o catálogo canônico de opções selecionáveis.
/// Produtos inativos deixam de aparecer como opção em novos leads, mas não
/// afetam leads que já usam aquele nome.
model Produto {
  id        String  @id @default(cuid())

  /// Instância (espaço de dados) dona deste registro. Ver `Workspace`.
  workspaceId String
  nome      String
  descricao String?
  ativo     Boolean @default(true)

  /// Identificador opcional para importação por planilha. Quando preenchido, o
  /// arquivo pode trazer este ID na coluna "produto" em vez do nome exato,
  /// evitando cadastrar uma segmentação nova e sem uso. É único quando definido.
  idImportacao String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([ativo, nome])
  @@unique([workspaceId, nome])
  @@unique([workspaceId, idImportacao])
}

/// Catálogo de marcas gerenciado na página de Segmentação. Mesma lógica de
/// Produto: o nome é a chave de negócio e os leads guardam a marca como texto.
model Marca {
  id        String  @id @default(cuid())

  /// Instância (espaço de dados) dona deste registro. Ver `Workspace`.
  workspaceId String
  nome      String
  descricao String?
  ativo     Boolean @default(true)

  /// Identificador opcional para importação por planilha (ver Produto).
  idImportacao String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([ativo, nome])
  @@unique([workspaceId, nome])
  @@unique([workspaceId, idImportacao])
}

/// Catálogo de personas gerenciado na página de Segmentação.
model Persona {
  id        String  @id @default(cuid())

  /// Instância (espaço de dados) dona deste registro. Ver `Workspace`.
  workspaceId String
  nome      String
  descricao String?
  ativo     Boolean @default(true)

  /// Identificador opcional para importação por planilha (ver Produto).
  idImportacao String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([ativo, nome])
  @@unique([workspaceId, nome])
  @@unique([workspaceId, idImportacao])
}

/// Catálogo de regiões gerenciado na página de Segmentação.
model Regiao {
  id        String  @id @default(cuid())

  /// Instância (espaço de dados) dona deste registro. Ver `Workspace`.
  workspaceId String
  nome      String
  descricao String?
  ativo     Boolean @default(true)

  /// Identificador opcional para importação por planilha (ver Produto).
  idImportacao String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([ativo, nome])
  @@unique([workspaceId, nome])
  @@unique([workspaceId, idImportacao])
}

/// Preferências da engine. Uma linha por instância (`workspaceId` é único).
model Settings {
  id String @id @default(cuid())

  /// Instância (espaço de dados) dona deste registro. Ver `Workspace`.
  workspaceId String @unique

  remetente  String @default("Engine Follow-up")
  numero     String @default("")
  assinatura String @default("")

  fuso                String  @default("America/Sao_Paulo")
  janelaInicio        String  @default("09:00")
  janelaFim           String  @default("20:00")
  limiteDiario        Int     @default(300)

  /// Máximo de mensagens enviadas em cada lote (por período de espera).
  maxEnviosPorPeriodo Int @default(50)
  /// Tempo de espera entre um lote e o próximo: valor numérico + unidade.
  periodoEsperaValor   Int    @default(1)
  /// Unidade do período de espera: "minutos" ou "horas".
  periodoEsperaUnidade String @default("horas")

  respeitarJanela     Boolean @default(true)
  pausarNoFimDeSemana Boolean @default(true)
  notificarFalhas     Boolean @default(true)
  chatPluginAtivo     Boolean @default(false)
  kanbanPluginAtivo   Boolean @default(false)
  assistentePluginAtivo Boolean @default(false)
  nocodePluginAtivo     Boolean @default(false)
  crmPluginAtivo        Boolean @default(false)
  agentesIaPluginAtivo  Boolean @default(false)
  /// Tema pronto do painel (ver lib/temas.ts). Vale para o modo claro e o escuro.
  temaApp            String  @default("oceano")
  /// Nome exibido no topo da sidebar (o subtítulo com a versão é fixo).
  appNome            String  @default("Medical Spin")
  /// Logo da sidebar como data URL (imagem já reduzida no navegador). Nulo = logo padrão.
  appLogo            String?
  /// Legado: cores avulsas substituídas por `temaApp`. Não são mais lidas nem gravadas.
  corPrincipal       String  @default("#00815a")
  corSecundaria      String  @default("#f0f5f2")
  corTerciaria       String  @default("#e3f5ec")

  atualizadoEm DateTime @updatedAt
}

/// Webhooks de saída configurados na página de Integrações.
/// O limite de 5 registros é aplicado na camada de serviço.
model Webhook {
  id     String  @id @default(cuid())

  /// Instância (espaço de dados) dona deste registro. Ver `Workspace`.
  workspaceId String
  nome   String
  url    String
  secret String  @default("")
  ativo  Boolean @default(true)

  /// Chaves dos eventos assinados (ver lib/webhook-events.ts).
  /// Guardadas como lista de texto para que novos eventos não exijam migration.
  eventos String[]

  ultimoEnvioEm     DateTime?
  ultimoEnvioStatus Int?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([criadoEm])
  @@index([workspaceId])
}

/// Erros e avisos de sistema — Evolution API, banco de dados, actions etc.
/// Separado de TimelineEvent porque não pertence ao contexto de um lead.
model AppLog {
  id      String      @id @default(cuid())

  /// Instância (espaço de dados) dona deste registro. Ver `Workspace`.
  workspaceId String
  nivel   AppLogNivel @default(erro)
  origem  String      /// Ex: "evolution", "campaigns", "leads", "webhooks"
  mensagem String
  detalhes String?    /// Stack trace, resposta HTTP, etc.
  data    DateTime    @default(now())

  @@index([data])
  @@index([nivel, data])
  @@index([origem, data])
  @@index([workspaceId])
}

model TimelineEvent {
  id        String    @id @default(cuid())
  tipo      EventType
  descricao String
  detalhes  String?
  data      DateTime  @default(now())
  sucesso   Boolean   @default(true)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  campanhaId String?
  campanha   Campaign? @relation(fields: [campanhaId], references: [id], onDelete: SetNull)

  mensagemId String?
  mensagem   CampaignMessage? @relation(fields: [mensagemId], references: [id], onDelete: SetNull)

  // O feed e os relatórios varrem por data, tipo e agrupam por lead/campanha.
  @@index([data])
  @@index([tipo, data])
  @@index([leadId, data])
  @@index([campanhaId])
  @@index([mensagemId])
}

/// Token de autenticação para o webhook de entrada (uma linha por instância).
/// Permite que sistemas externos enviem eventos para este painel via POST.
model InboundWebhookToken {
  id    String  @id @default("default")

  /// Instância (espaço de dados) dona deste registro. Ver `Workspace`.
  workspaceId String @unique
  token String  /// Valor gerado: whin_<64 chars hex>
  ativo Boolean @default(true)

  ultimoUsoEm DateTime?
  criadoEm    DateTime  @default(now())
  atualizadoEm DateTime @updatedAt
}

/// Token de acesso ao MCP (`/api/mcp`) de uma instância. O MCP vem DESLIGADO: só
/// existe depois que alguém da instância gera o token em Integrações, e o token
/// define em qual instância as ferramentas rodam (nunca em todas). Guardamos só o
/// hash SHA-256 (o token aparece uma única vez, ao gerar) e um prefixo para identificá-lo.
model McpToken {
  id String @id @default(cuid())

  /// Instância (espaço de dados) dona deste registro. Ver `Workspace`.
  workspaceId String @unique

  tokenHash String  @unique
  /// Início do token (ex.: `mcp_1a2b3c4d`), só para reconhecê-lo na tela.
  prefixo   String
  ativo     Boolean @default(true)

  /// Funções (tools) que este token pode executar, escolhidas pelo usuário ANTES de gerar o token.
  /// Nomes de `lib/mcp/catalogo.ts`; a IA só enxerga essas. Vazio = nada liberado.
  ferramentas String[] @default([])

  ultimoUsoEm  DateTime?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
}

/// Eventos recebidos pelo webhook de entrada (/api/webhook/entrada).
/// Armazenados para auditoria e visibilidade na UI.
model InboundEvent {
  id      String   @id @default(cuid())

  /// Instância (espaço de dados) dona deste registro. Ver `Workspace`.
  workspaceId String
  evento  String   /// Nome do evento enviado pelo sistema externo.
  origem  String?  /// IP/host de origem capturado do header x-forwarded-for.
  payload Json     /// Corpo completo recebido (dados livres).
  recebidoEm DateTime @default(now())

  @@index([recebidoEm])
  @@index([evento, recebidoEm])
  @@index([workspaceId])
}

/// Instâncias de WhatsApp criadas por este painel.
/// A Evolution API pode hospedar instâncias de outros sistemas; guardamos aqui
/// apenas o `nome` (chave de negócio, igual ao instanceName na Evolution) das
/// que foram criadas por aqui, para que a listagem mostre somente essas.
model Instance {
  id       String  @id @default(cuid())

  /// Instância (espaço de dados) dona deste registro. Ver `Workspace`.
  workspaceId String
  nome     String  @unique
  numero   String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([criadoEm])
  @@index([workspaceId])
}

/// Fluxos do plugin "No Code" (editor visual de automações do próprio app).
model NoCodeFlow {
  id    String  @id @default(cuid())

  /// Instância (espaço de dados) dona deste registro. Ver `Workspace`.
  workspaceId String
  nome  String
  ativo Boolean @default(false)
  /// Fluxo do sistema (o "Fluxo de resposta" do app): nasce ativo e não pode ser
  /// desativado nem excluído. Só existe um (índice único parcial na migration).
  sistema Boolean @default(false)
  /// Envia cada execução (completa) para um webhook externo, para guardá-la fora do app.
  execWebhookAtivo   Boolean @default(false)
  execWebhookUrl     String?
  /// Segredo opcional: assina o corpo enviado (HMAC-SHA256 no header X-Execution-Signature).
  execWebhookSegredo String?
  /// "automacao" (padrão) | "bot". Bots respondem conversas do chat (ver `services/bots.ts`).
  tipo String @default("automacao")
  /// Bot de entrada (triagem): atende quem ainda não está em nenhum departamento.
  botEntrada Boolean @default(false)
  /// Bot de departamento: atende as conversas desse departamento enquanto não houver humano.
  /// Se o departamento for excluído o bot fica órfão (sem departamento e sem ser de entrada): nunca roda.
  departamentoId String?
  departamento   Departamento? @relation(fields: [departamentoId], references: [id], onDelete: SetNull)
  /// Nós do canvas: [{ id, type, name, position: {x,y}, config }].
  nodes Json    @default("[]")
  /// Conexões: [{ id, source, sourceHandle, target }].
  edges Json    @default("[]")

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  execucoes     NoCodeExecution[]
  conversasBot  BotConversa[]

  @@index([atualizadoEm])
  @@index([workspaceId])
  @@index([departamentoId])
}

/// Estado do bot numa conversa (no máximo uma linha por lead): se o bot está ligado,
/// em que bloco ele aguarda a resposta do lead e quando houve a última interação.
/// Quando um humano assume a conversa o bot é pausado (`botAtivo = false`) e só volta
/// quando alguém o reativa para ESSA conversa.
model BotConversa {
  leadId String @id
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  botAtivo      Boolean   @default(true)
  /// Por que o bot foi pausado (ex.: "Conversa assumida por Fulano").
  pausadoMotivo String?
  pausadoEm     DateTime?

  /// Bot que está conduzindo a conversa e o bloco (menu) em que espera a resposta do lead.
  flowId         String?
  flow           NoCodeFlow? @relation(fields: [flowId], references: [id], onDelete: SetNull)
  aguardandoNoId String?
  /// Respostas inválidas seguidas ao menu atual.
  tentativas     Int         @default(0)

  ultimaInteracaoEm DateTime @default(now())
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt

  @@index([flowId])
}

/// Histórico de execuções dos fluxos (uma por evento recebido ou teste manual).
model NoCodeExecution {
  id      String     @id @default(cuid())
  flowId  String
  flow    NoCodeFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  /// "sucesso" | "erro" | "ignorado"
  status  String
  /// "webhook" | "teste"
  origem  String     @default("webhook")
  entrada Json?
  /// Passo a passo: [{ nodeId, nome, tipo, status, saida, erro, ms }].
  passos  Json       @default("[]")
  erro    String?
  duracaoMs Int      @default(0)
  iniciadoEm DateTime @default(now())

  /// Entrega ao webhook de execuções: null (não se aplica) | "pendente" | "enviando" | "enviado" | "falha".
  webhookStatus            String?
  webhookTentativas        Int       @default(0)
  webhookErro              String?
  webhookUltimaTentativaEm DateTime?
  webhookEnviadoEm         DateTime?

  @@index([flowId, iniciadoEm])
  @@index([iniciadoEm])
  @@index([webhookStatus, iniciadoEm])
}

/// Configuração do backup para webhook externo (uma linha por instância).
/// O backup (manual ou automático) envia o arquivo JSON completo das seções
/// escolhidas, num único POST binário, para `url`. Ver `services/backup.ts`.
model BackupConfig {
  id String @id @default(cuid())

  /// Instância (espaço de dados) dona deste registro. Ver `Workspace`.
  workspaceId String @unique

  url String @default("")
  /// Segredo opcional: assina cada envio (HMAC-SHA256 no header X-Backup-Signature).
  segredo String?

  /// Seções incluídas no backup (chaves de `lib/backup/secoes.ts`). Vale para o
  /// automático e é o ponto de partida do manual.
  secoes String[] @default([])

  autoAtivo          Boolean   @default(false)
  /// "intervalo" (a cada N horas) | "diario" (todo dia no horário) | "semanal" (dia da semana + horário).
  autoModo           String    @default("diario")
  autoIntervaloHoras Int       @default(24)
  /// "HH:mm", no fuso do servidor (America/Sao_Paulo).
  autoHorario        String    @default("03:00")
  /// 0 = domingo … 6 = sábado.
  autoDiaSemana      Int       @default(0)
  /// Próxima execução automática. Quem conseguir "reservar" este valor roda o backup.
  autoProximoEm      DateTime?

  atualizadoEm DateTime @updatedAt
}

/// Histórico de backups enviados (manuais e automáticos), com o estado da entrega.
model BackupExecucao {
  id     String   @id @default(cuid())

  /// Instância (espaço de dados) dona deste registro. Ver `Workspace`.
  workspaceId String
  /// "manual" | "automatico"
  origem String
  /// "enviando" | "enviado" | "falha"
  status String
  /// Seções incluídas neste backup.
  secoes String[]
  /// Linhas e partes enviadas por tabela: { Lead: { linhas, partes } }.
  resumo Json?

  partesEnviadas Int @default(0)
  /// Estimativa feita antes do envio (os dados podem mudar durante ele).
  partesTotal    Int @default(0)
  bytes          Int @default(0)
  tentativas     Int @default(1)
  erro           String?

  criadoEm          DateTime  @default(now())
  /// Também serve de "sinal de vida": é atualizado a cada parte enviada.
  ultimaTentativaEm DateTime?
  concluidoEm       DateTime?

  @@index([criadoEm])
  @@index([status, ultimaTentativaEm])
  @@index([workspaceId])
}

/// Instância do painel: um espaço de dados isolado. Cada admin tem a sua (criada
/// quando o Root cadastra o admin) e os usuários padrão que ele criar entram
/// nela. A instância principal (`principal = true`) é a do Root e dos usuários
/// que ele criar. Nenhuma consulta atravessa instâncias: `lib/prisma.ts` injeta
/// `workspaceId` automaticamente em toda leitura e escrita.
///
/// `workspaceId` nas demais tabelas é coluna simples (sem FK declarada): assim o
/// filtro vale também nas escritas aninhadas, e a exclusão da instância é feita
/// por `excluirWorkspace` (services/workspaces.ts).
model Workspace {
  id        String  @id @default(cuid())
  nome      String
  /// Instância do Root. Só pode existir uma (índice único parcial na migration).
  principal Boolean @default(false)
  /// Instância desativada: ninguém dela entra e os envios automáticos param.
  ativo     Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

/// Usuários do painel. O primeiro admin é criado no primeiro login com as
/// credenciais de `AUTH_USERNAME`/`AUTH_PASSWORD` (ver `services/users.ts`).
model User {
  id        String @id @default(cuid())

  /// Instância (espaço de dados) dona deste registro. Ver `Workspace`.
  workspaceId String
  /// Login (minúsculo, único).
  username  String @unique
  nome      String
  /// Hash scrypt no formato `scrypt$<salt>$<hash>` (ver `lib/password.ts`).
  senhaHash String

  role UserRole @default(padrao)
  /// Chaves das seções liberadas (ver `lib/permissoes.ts`). Ignorado para root,
  /// que sempre acessa tudo. Para admin, define o que ele acessa e também o teto
  /// do que ele pode liberar para usuários padrão.
  secoes String[] @default([])
  /// Poderes de gestão do admin, definidos pelo root (ver `PODERES` em
  /// `lib/permissoes.ts`). Ignorado para root (tem todos) e para usuário padrão (nenhum).
  poderes String[] @default([])
  /// Usuário inativo não consegue entrar e perde a sessão na hora.
  ativo Boolean @default(true)

  /// Preferência PESSOAL: o tema escolhido vale só para este usuário.
  temaApp String @default("oceano")

  /// Preferência PESSOAL do chat: quando ligada, as mensagens enviadas por este
  /// usuário chegam ao lead com o nome dele no início (ver `sendLeadMessageAction`).
  chatIdentificarRemetente Boolean @default(false)

  /// Foto de perfil: quando foi trocada (nulo = sem foto). Serve de versão na URL da imagem
  /// (cache do navegador) e evita carregar os bytes junto com o usuário a cada requisição.
  fotoAtualizadaEm DateTime?
  foto             UserFoto?

  /// Plugin CRM: perfil de atendente deste usuário (opcional).
  atendente Atendente?

  /// Chat: templates de mensagem pessoais (atalho "/nome"), até 10 por usuário.
  chatTemplates ChatTemplate[]

  /// Chat interno (equipe): conversas de que participa e mensagens que escreveu.
  internoParticipacoes InternoParticipante[]
  internoMensagens     InternoMensagem[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([role])
  @@index([workspaceId])
}

/// Foto de perfil do usuário. Imagem pequena (já reduzida pelo navegador, ~256 px), por isso
/// fica no banco: sobrevive a deploys e não depende de volume persistente. Tabela separada
/// para os bytes nunca viajarem junto com `User` (que é lido a cada requisição).
model UserFoto {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dados        Bytes
  mime         String
  tamanho      Int
  atualizadoEm DateTime @default(now()) @updatedAt
}

// ---------------------------------------------------------------------------
// Plugin CRM: departamentos, atendentes e transferência de conversas do chat.
// ---------------------------------------------------------------------------

/// Departamento de atendimento (ex.: Comercial, Suporte). Pode ser inativado
/// (deixa de receber transferências) ou excluído (as conversas dele ficam sem
/// departamento).
model Departamento {
  id        String  @id @default(cuid())

  /// Instância (espaço de dados) dona deste registro. Ver `Workspace`.
  workspaceId String
  nome      String
  descricao String?
  ativo     Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  atendentes   AtendenteDepartamento[]
  atendimentos LeadAtendimento[]
  /// Bots (fluxos No Code do tipo "bot") deste departamento.
  bots         NoCodeFlow[]
  /// Bot especialista em follow-up deste departamento (no máximo um).
  followUpBot  FollowUpBot?
  /// Plugin Agentes de IA: agente que responde as conversas deste departamento (opcional).
  agenteIaId   String?
  agenteIa     AgenteIA? @relation(fields: [agenteIaId], references: [id], onDelete: SetNull)

  @@index([ativo, nome])
  @@index([agenteIaId])
  @@unique([workspaceId, nome])
}

/// Atendente = um `User` (admin ou padrão) com perfil no CRM. O login, a senha e
/// o nível continuam em `User`; aqui ficam só os dados de atendimento.
/// `ativo` controla apenas o recebimento de conversas, sem tirar o acesso ao painel.
model Atendente {
  id     String  @id @default(cuid())
  userId String  @unique
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ativo  Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  departamentos AtendenteDepartamento[]
  atendimentos  LeadAtendimento[]

  @@index([ativo])
}

/// Vínculo N:N entre atendentes e departamentos.
model AtendenteDepartamento {
  atendenteId    String
  atendente      Atendente    @relation(fields: [atendenteId], references: [id], onDelete: Cascade)
  departamentoId String
  departamento   Departamento @relation(fields: [departamentoId], references: [id], onDelete: Cascade)

  @@id([atendenteId, departamentoId])
  @@index([departamentoId])
}

/// Quem está responsável pela conversa de um lead no chat (no máximo uma linha
/// por lead). Departamento e atendente são opcionais: dá para transferir só
/// para a fila de um departamento, sem atendente definido.
model LeadAtendimento {
  leadId String @id
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  departamentoId String?
  departamento   Departamento? @relation(fields: [departamentoId], references: [id], onDelete: SetNull)

  atendenteId String?
  atendente   Atendente? @relation(fields: [atendenteId], references: [id], onDelete: SetNull)

  transferidoEm DateTime @default(now())

  @@index([departamentoId])
  @@index([atendenteId])
}

/// Histórico de transferências. Guarda os NOMES no momento da transferência,
/// então o registro continua legível mesmo se o departamento/atendente for
/// excluído depois.
model AtendimentoTransferencia {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  deDepartamento   String?
  paraDepartamento String?
  deAtendente      String?
  paraAtendente    String?
  /// Nome de quem executou a transferência.
  porUsuario       String
  motivo           String?
  data             DateTime @default(now())

  @@index([leadId, data])
}

/// Bot especialista em FOLLOW-UP de um departamento (no máximo um por departamento).
/// Quando o lead fica `minutosSemResposta` sem responder à última mensagem da equipe, o bot envia
/// um template. Só atua em conversas do departamento, sem campanha, cuja última mensagem da equipe
/// foi enviada DEPOIS de o bot ser ativado (`ativadoEm`): ligar o bot não reabre conversas antigas.
model FollowUpBot {
  id String @id @default(cuid())

  /// Instância (espaço de dados) dona deste registro. Ver `Workspace`.
  workspaceId String
  departamentoId String       @unique
  departamento   Departamento @relation(fields: [departamentoId], references: [id], onDelete: Cascade)

  nome  String
  ativo Boolean   @default(false)
  /// Quando foi ligado pela última vez (só mensagens enviadas depois disso disparam follow-up).
  ativadoEm DateTime?

  /// Tempo sem resposta do lead até enviar o follow-up (em minutos).
  minutosSemResposta Int @default(60)
  /// Quantos follow-ups seguidos enviar enquanto o lead não responder (cada um espera `minutosSemResposta`).
  maxFollowUps Int @default(1)
  /// "aleatorio" (sorteia entre os templates ativos) | "especifico" (sempre `templateFixoId`).
  modoTemplate  String  @default("aleatorio")
  templateFixoId String?
  /// Só envia entre `janelaInicio` e `janelaFim` (hora cheia, 0–24), no horário do servidor.
  janelaAtiva  Boolean @default(false)
  janelaInicio Int     @default(8)
  janelaFim    Int     @default(20)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  templates FollowUpTemplate[]

  @@index([workspaceId])
}

/// Chat: template de mensagem pessoal. No campo de mensagem, digitar "/nome" insere o
/// texto do template. Cada usuário tem até 10 (limite checado em `services/chat-templates.ts`).
/// O texto aceita as mesmas variáveis do chat (ex.: `{{primeiro_nome}}`), resolvidas no envio.
model ChatTemplate {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Nome do atalho, sem a barra: minúsculo, letras/números/hífen/sublinhado.
  nome  String
  texto String

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([userId, nome])
}

/// Mensagem-modelo do bot de follow-up. Aceita as mesmas variáveis do chat (ex.: `{{primeiro_nome}}`).
model FollowUpTemplate {
  id    String      @id @default(cuid())
  botId String
  bot   FollowUpBot @relation(fields: [botId], references: [id], onDelete: Cascade)

  nome  String
  texto String
  ativo Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  conversas FollowUpConversa[]

  @@index([botId])
}

/// Ajustes e andamento do follow-up numa conversa (no máximo uma linha por lead).
model FollowUpConversa {
  leadId String @id
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// Follow-up desligado só para este chat.
  desativado Boolean @default(false)
  /// Template escolhido manualmente para este chat (nulo = vale a regra do bot: específico ou aleatório).
  templateId String?
  template   FollowUpTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  /// Follow-ups enviados desde a última resposta do lead (zera sozinho quando ele responde).
  enviados        Int       @default(0)
  ultimoEnvioEm   DateTime?
  ultimoTemplateId String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([templateId])
}

// ---------------------------------------------------------------------------
// Plugin Agentes de IA: agentes de atendimento que respondem o chat (só mensagens).
// ---------------------------------------------------------------------------

/// Agente de IA de atendimento. Por enquanto só o provedor "claude" (API da Anthropic): o
/// usuário informa a chave de API, escolhe o modelo e escreve o prompt. O agente só responde
/// mensagens (não executa comandos). Pode atender um ou mais departamentos
/// (`Departamento.agenteIaId`) e/ou ser o agente de ENTRADA (quem ainda não tem departamento);
/// só um agente por instância é o de entrada (índice único parcial na migration).
model AgenteIA {
  id String @id @default(cuid())

  /// Instância (espaço de dados) dona deste registro. Ver `Workspace`.
  workspaceId String
  nome        String
  ativo       Boolean @default(false)
  /// Provedor de IA: "claude" (Anthropic), "groq" ou "compativel" (qualquer API compatível com a
  /// da OpenAI, usando `baseUrl`).
  provedor    String  @default("claude")
  /// Endereço base da API (só para "compativel"; Groq e Claude usam o endereço padrão).
  baseUrl     String?
  /// Id do modelo (ex.: "claude-sonnet-5-5").
  modelo      String
  /// Chave de API CRIPTOGRAFADA (AES-256-GCM, ver `lib/segredo.ts`). Nunca vai para o backup.
  apiKey      String  @default("")
  /// Instruções do agente de atendimento (system prompt).
  prompt      String
  /// Agente de entrada (triagem): atende quem ainda não está em nenhum departamento.
  entrada     Boolean @default(false)
  /// Reativação automática (opcional): depois de tantos minutos sem atividade da equipe, o agente
  /// volta a responder uma conversa que um humano assumiu. Nulo = desligada (o agente só volta
  /// quando alguém o reativa no chat).
  reativarAposMinutos Int?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  departamentos Departamento[]

  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Plugin Chat: chat interno entre os usuários do painel (não passa pelo WhatsApp).
// ---------------------------------------------------------------------------

/// Conversa interna: direta (2 pessoas) ou em grupo. Mensagens de texto ficam no banco;
/// imagens/arquivos NÃO: ficam numa pasta do servidor e são apagados quando baixados
/// (ver `lib/interno-storage.ts`). Aqui só os metadados do anexo.
model InternoConversa {
  id String @id @default(cuid())

  /// Instância (espaço de dados) dona deste registro. Ver `Workspace`.
  workspaceId String
  /// "direta" ou "grupo".
  tipo        String   @default("direta")
  /// Nome do grupo (conversas diretas não têm).
  nome        String?
  /// Conversa direta: chave única "<idMenor>:<idMaior>" para não duplicar o par.
  chaveDireta String?
  criadoPorId String?

  criadoEm        DateTime @default(now())
  /// Data da última mensagem (ordena a lista).
  ultimaMensagemEm DateTime @default(now())

  participantes InternoParticipante[]
  mensagens     InternoMensagem[]

  @@unique([workspaceId, chaveDireta])
  @@index([workspaceId, ultimaMensagemEm])
}

model InternoParticipante {
  conversaId String
  conversa   InternoConversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Tudo o que for posterior a isto conta como não lido.
  ultimaLeituraEm DateTime @default(now())
  entrouEm        DateTime @default(now())

  @@id([conversaId, userId])
  @@index([userId])
}

model InternoMensagem {
  id         String          @id @default(cuid())
  conversaId String
  conversa   InternoConversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  autorId    String
  autor      User            @relation(fields: [autorId], references: [id], onDelete: Cascade)

  /// Texto (ou legenda do anexo).
  texto String @default("")

  /// Anexo (opcional): só metadados; o conteúdo fica em disco até alguém baixar.
  anexoId      String?
  anexoTipo    String?
  anexoMime    String?
  anexoTamanho Int?
  anexoNome    String?
  /// Quem já baixou o anexo. Quando todos (menos o autor) baixam, o arquivo é apagado.
  baixadoPor   String[] @default([])

  criadoEm DateTime @default(now())

  @@index([conversaId, criadoEm])
  @@index([anexoId])
}
