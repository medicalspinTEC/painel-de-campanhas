# ---------------------------------------------------------------------------
# Arquivo pronto para `docker compose up --build` (Postgres do próprio compose)
# ---------------------------------------------------------------------------
# ATENCAO: nunca use "process.env.X" aqui. Um arquivo .env guarda VALORES
# literais, nao codigo JavaScript. Coloque a string de conexao real.

# Credenciais do container Postgres (serviço `db`)
POSTGRES_USER=campanhas
POSTGRES_PASSWORD=campanhas
POSTGRES_DB=campanhas

# String de conexão usada pela app e pelas migrations.
# Host = "db" (nome do serviço no docker-compose), não "localhost".
DATABASE_URL=postgresql://campanhas:campanhas@db:5432/campanhas?schema=public

# ---------------------------------------------------------------------------
# Integrações (opcionais — preencha com os valores reais quando for usar)
# ---------------------------------------------------------------------------
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=
N8N_DISPAROS_WEBHOOK_URL=
INGEST_TOKEN=
