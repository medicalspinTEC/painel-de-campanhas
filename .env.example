# ---------------------------------------------------------------------------
# Banco de dados (obrigatório)
# ---------------------------------------------------------------------------
# Credenciais usadas pelo container do Postgres (serviço `db`).
POSTGRES_USER=campanhas
POSTGRES_PASSWORD=campanhas
POSTGRES_DB=campanhas

# String de conexão usada pela app e pelas migrations.
# Dentro do docker-compose use o host "db" (nome do serviço).
DATABASE_URL=postgresql://campanhas:campanhas@db:5432/campanhas?schema=public

# ---------------------------------------------------------------------------
# Integrações (opcionais — o código tem valores padrão)
# ---------------------------------------------------------------------------
# Evolution API (envio de mensagens no WhatsApp)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=

# Webhook de disparos (n8n)
N8N_DISPAROS_WEBHOOK_URL=

# Token esperado no endpoint /api/eventos
INGEST_TOKEN=
